# LLM for quote selection. LLM_PROVIDER is "cerebras" (default), "anthropic", or "openai".
# Get a Cerebras key at https://cloud.cerebras.ai. The default model is gpt-oss-120b.
LLM_PROVIDER=cerebras
LLM_API_KEY=
# LLM_MODEL=qwen-3.8-27b
# Other providers:
#   Claude:     LLM_PROVIDER=anthropic (default model claude-sonnet-5-5)
#   OpenAI:     LLM_PROVIDER=openai LLM_MODEL=gpt-5
#   Ollama:     LLM_PROVIDER=openai LLM_MODEL=qwen3:8b LLM_BASE_URL=http://localhost:11434/v1
#   OpenRouter: LLM_PROVIDER=openai LLM_MODEL=<model-id> LLM_BASE_URL=https://openrouter.ai/api/v1

# Longest quote to post, in characters.
# COMRADE_MAX_QUOTE_CHARS=300

# Ollama embeddings. Run Ollama locally, or tunnel to the server:
#   ssh -N -L 11434:127.0.0.1:11434 user@your-server
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Reddit script app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=comrade-bot/0.1 by u/YOUR_USERNAME
