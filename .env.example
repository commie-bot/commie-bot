ANTHROPIC_API_KEY=
COMRADE_MODEL=claude-sonnet-5-5

# Ollama embeddings. Run Ollama locally, or tunnel to the server:
#   ssh -N -L 11434:127.0.0.1:11434 user@your-server
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Reddit script app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=comrade-bot/0.1 by u/YOUR_USERNAME
